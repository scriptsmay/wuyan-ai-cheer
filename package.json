{
  "name": "wuyan-ai-cheer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "无言 AI 应援与每日加油打卡 Web H5",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "npx eslint . --max-warnings 0",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "vitest run",
    "build": "npm run typecheck && npm run test && vite build && node ./scripts/copy-dist-404.mjs",
    "deploy": "npm run build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@lucide/vue": "^1.27.0",
    "harmonyos-sans-sc-webfont-splitted": "^1.1.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
